{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CabinRent API (.NET 10)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/CabinRent.API/bin/Debug/net10.0/CabinRent.API.dll",
      "cwd": "${workspaceFolder}/backend/CabinRent.API",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
