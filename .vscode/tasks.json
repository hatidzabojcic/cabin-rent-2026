{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: restore",
      "type": "process",
      "command": "dotnet",
      "args": ["restore", "CabinRent.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "CabinRent.sln"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "CabinRent.sln"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "docker: start all",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "-d", "--build"],
      "problemMatcher": []
    },
    {
      "label": "docker: stop all",
      "type": "process",
      "command": "docker",
      "args": ["compose", "down"],
      "problemMatcher": []
    },
    {
      "label": "database: add migration",
      "type": "process",
      "command": "dotnet",
      "args": [
        "tool", "run", "dotnet-ef", "migrations", "add", "${input:migrationName}",
        "--project", "backend/CabinRent.Infrastructure",
        "--startup-project", "backend/CabinRent.API",
        "--output-dir", "Persistence/Migrations"
      ],
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Naziv nove EF Core migracije",
      "default": "DescribeChange"
    }
  ]
}
